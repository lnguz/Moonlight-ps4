+
+// moonlight-ps4: run one of the host's server commands (Apollo protocol
+// extension 0x3000). cmdId is the index into the ServerCommand list that
+// Apollo publishes in /serverinfo for clients with the server_cmd permission.
+// Plain Sunshine has no handler for this type and ignores it.
+int LiSendExecServerCmd(uint8_t cmdId) {
+    uint8_t payload[4] = { cmdId, 0, 0, 0 };
+
+    // Only the Sunshine encrypted table (Gen7Enc) carries the 0x3000 slot.
+    if (!IS_SUNSHINE() || packetTypes != (short*)packetTypesGen7Enc) {
+        return -2;
+    }
+
+    return sendMessageAndForget(packetTypes[IDX_EXEC_SERVER_CMD],
+                                sizeof(payload), payload,
+                                CTRL_CHANNEL_GENERIC,
+                                ENET_PACKET_FLAG_RELIABLE,
+                                false) ? 0 : -1;
+}
+
+// moonlight-ps4: tiny unreliable control packet that keeps the client's
+// Wi-Fi radio out of power save between input events (same idea as
+// Artemis' "prevent packet loss" option). It reuses the periodic ping
+// type (0x0200), which both Sunshine and Apollo accept and ignore.
+int LiSendKeepAlivePing(void) {
+    static const uint8_t payload[8] = { 0 };
+
+    if (!IS_SUNSHINE() || peer == NULL) {
+        return -2;
+    }
+
+    return sendMessageAndForget(0x0200, sizeof(payload), payload,
+                                CTRL_CHANNEL_GENERIC,
+                                ENET_PACKET_FLAG_UNSEQUENCED,
+                                false) ? 0 : -1;
+}
